config neko 'cfg'
	option enabled '1'
	option core_mode 'mihomo'
	option tcp_mode 'redirect'
	option udp_mode 'tun'
	option selected_config '/etc/neko/config/neko.yaml'
	option delay '2'
	option tun_interface 'Meta'
	option lan_interface 'br-lan'
	option port '9090'
	option show_ip '1'
	option show_isp '1'
	option show_luci '1'
