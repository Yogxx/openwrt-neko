
config neko 'cfg'
	option enabled '1'
	option php_server '0'
	option new_interface '0'
	option delay '2'
	option selected_config '/etc/neko/config/config.yaml'
	option core_mode 'mihomo'
	option show_ip '0'
	option show_isp '1'
	option show_luci '1'
	option proxy_mode 'tun'
	option tcp_mode 'redirect'
	option udp_mode 'tun'

