#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

SINGBOX="/usr/bin/sing-box"
MIHOMO="/usr/bin/mihomo"
CONFIG_SB="/etc/neko/config/config.json"
CONFIG_MH="/etc/neko/config/config.yaml"

start_service() {
    core=$(uci -q get neko.cfg.core_mode)
    logger "NEKO: start ($core)"

    procd_open_instance
    if [ "$core" = "singbox" ]; then
        procd_set_param command "$SINGBOX" run -c "$CONFIG_SB"
    else
        procd_set_param command "$MIHOMO" -d /etc/neko -f "$CONFIG_MH"
    fi
    procd_set_param respawn 5 10 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_started() {
    add_firewall_rule
}

service_stopped() {
    remove_firewall_rule
}

reload_service() {
    restart
}

add_firewall_rule() {
    RULE="neko_tun_rule"

    for i in $(seq 1 5); do
        ip link show Meta >/dev/null 2>&1 && break
        sleep 1
    done
    ip link show Meta >/dev/null 2>&1 || return 0

    uci -q delete firewall.$RULE
    uci set firewall.$RULE="rule"
    uci set firewall.$RULE.name="Neko TUN"
    uci set firewall.$RULE.src="lan"
    uci set firewall.$RULE.device="Meta"
    uci set firewall.$RULE.proto="tcp udp"
    uci set firewall.$RULE.target="ACCEPT"
    uci commit firewall

    fw4 reload
    logger "NEKO: firewall added"
}

remove_firewall_rule() {
    RULE="neko_tun_rule"
    uci -q delete firewall.$RULE
    uci commit firewall
    fw4 reload
    logger "NEKO: firewall removed"
}
