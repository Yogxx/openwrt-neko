#!/bin/bash
# Neko Script - FW4 Only

neko_dir="/etc/neko"
neko_tmp_dir="$neko_dir/tmp"
neko_core="$neko_dir/core"
neko_bin="/usr/bin/mihomo"
neko_www="/www/nekoclash"
neko_config=$(uci -q get neko.cfg.selected_config)

php_bin="/usr/bin/php"
php_address="0.0.0.0"
php_port="8080"

tun_bin="$neko_core/tun"
reload_bin="$neko_core/reload"
firewall="/etc/init.d/firewall"

neko_log="$neko_tmp_dir/neko_log.txt"
neko_pid_path="$neko_tmp_dir/neko_pid.txt"
php_pid_path="$neko_tmp_dir/php_pid.txt"
log="$neko_tmp_dir/log.txt"

neko_ver() {
    if command -v apk >/dev/null 2>&1; then
        # OpenWrt 25.12+ (apk)
        neko_version="$(apk list --installed luci-app-neko 2>/dev/null \
            | awk '{print $1}' \
            | cut -d' ' -f1 \
            | sed 's/^luci-app-neko-//')"
    elif command -v opkg >/dev/null 2>&1; then
        # OpenWrt 24.10 ke bawah (opkg)
        neko_version="$(opkg list-installed luci-app-neko 2>/dev/null \
            | awk '{print $1}' \
            | cut -d' ' -f1 \
            | sed 's/^luci-app-neko-//')"
    else
        neko_version="unknown"
    fi

    [ -z "$neko_version" ] && neko_version="unknown"
}

# ==== Logging Function ====
logs() {
    echo "[ $(date +%T) ] $1"
    if [[ -z "$2" ]]; then
        echo "[ $(date +%T) ] $1" >> "$log"
    elif [[ $2 -eq 2 ]]; then
        echo "[ $(date +%T) ] $1" > "$log"
    elif [[ $2 -eq 3 ]]; then
        echo "[ $(date +%T) ] $1" >> "$log"
        exit 1
    fi
}

# ==== Start Neko ====
neko_start() {
    neko_ver
    logs "Starting Neko v.$neko_version" 2

    [[ -f "$neko_pid_path" ]] && { 
        logs "- Neko is Running. Killing PID: $(cat $neko_pid_path)"
        $tun_bin stop >> "$log"
        kill $(cat "$neko_pid_path") 2>/dev/null
        uci set neko.cfg.enabled='0'
        uci commit neko
        rm -f "$neko_pid_path"
        logs "- Restarting Neko..."
    }

    if [[ -f "$neko_bin" ]]; then
        rpid=$(pgrep "mihomo|reload")
        [[ -n "$rpid" ]] && kill $rpid
        rm -f "$neko_log"

        logs "- Restarting Firewall"
        $firewall restart

        $neko_bin -f "$neko_config" -d "$neko_dir" >> "$neko_log" &
        sleep 1
        neko_pid=$(pgrep mihomo)

        if [[ -z "$neko_pid" ]]; then
            for file in "$neko_core"/*; do
                [[ ! -x "$file" ]] && chmod +x "$file"
            done
            logs "- Retry Starting Neko"
            $neko_bin -f "$neko_config" -d "$neko_dir" >> "$neko_log" &
            sleep 1
            neko_pid=$(pgrep mihomo)
        fi

        logs "- Neko Started. PID: $neko_pid"
        logs "- Config: $neko_config"
        echo "$neko_pid" > "$neko_pid_path"

        # Start TUN FW4 only
        $tun_bin >> "$log"

        uci set neko.cfg.enabled='1'
        uci commit neko
        service neko enable
        $reload_bin "$neko_version" > /dev/null 2>&1 &
    else
        logs "- Core Binary Not Found!!!"
    fi
    logs "Done"
}

# ==== Stop Neko ====
neko_stop() {
    logs "Stopping Neko..." 2
    $tun_bin stop >> "$log"
    if [[ -f "$neko_pid_path" ]]; then
        logs "- Killing Neko PID: $(cat "$neko_pid_path")"
        $firewall restart
        kill $(cat "$neko_pid_path") 2>/dev/null
        rm -f "$neko_pid_path"
        rpid=$(pgrep "mihomo|reload")
        [[ -n "$rpid" ]] && kill $rpid
        logs "Neko Stopped"
        echo "Neko Disabled." > "$neko_log"
    else
        logs "Neko Not Running"
    fi
    uci set neko.cfg.enabled='0'
    uci commit neko
    service neko disable
}

# ==== Restart Neko ====
neko_restart() {
    logs "Restarting Neko..." 2
    neko_start
    logs "Restart Complete"
}

# ==== PHP Server Control ====
php_start() {
    logs "Checking PHP Server..."
    [[ -f "$php_pid_path" ]] && { logs "- PHP Server Running. Killing PID: $(cat $php_pid_path)"; kill $(cat "$php_pid_path") 2>/dev/null; rm -f "$php_pid_path"; }
    nohup $php_bin -S $php_address:$php_port -t "$neko_www" > /dev/null 2>&1 &
    php_pid=$(pgrep php)
    echo "$php_pid" > "$php_pid_path"
    logs "- PHP Server Started. PID: $php_pid"
    logs "- PHP Running at $php_address:$php_port"
}

php_stop() {
    [[ -f "$php_pid_path" ]] && { logs "- Killing PHP PID: $(cat $php_pid_path)"; kill $(cat "$php_pid_path") 2>/dev/null; rm -f "$php_pid_path"; } || logs "- PHP Server Not Running"
}

# ==== Backup & Restore ====
neko_backup() {
    cd "$neko_dir"
    filename="neko_backup_$(date +%F_%H%M%S).tar.gz"
    tar -czvf "$filename" config proxy_provider rule_provider
    mv "$filename" "/tmp/$filename"
}

neko_restore() {
    cd "$neko_dir"
    rm -rf config/* proxy_provider/* rule_provider/*
    tar -xzf *.tar.gz
    rm -f *.tar.gz
}

# ==== Cleanup ====
cleanup() {
    logs "Cleaning Up..." 2
    neko_stop
    php_stop
    logs "Cleanup Done"
}

# ==== Option Parsing ====
while getopts ":skrpcvhbx" signal; do
    case $signal in
        s) neko_start ;;
        k) neko_stop ;;
        r) neko_restart ;;
        p) php_start ;;
        c) cleanup ;;
        b) neko_backup ;;
        x) neko_restore ;;
        v) neko_ver; echo "v.$neko_version" ;;
        h)
            echo "Neko Commands:"
            echo " -s : Start Neko Proxy"
            echo " -p : Start PHP Server"
            echo " -k : Stop Neko Proxy"
            echo " -r : Restart Neko Proxy"
            echo " -c : Cleanup (Stop Neko + PHP)"
            echo " -b : Backup Config"
            echo " -x : Restore Backup"
            echo " -v : Version"
            echo " -h : Help"
            ;;
    esac
done
