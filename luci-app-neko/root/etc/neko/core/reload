#!/bin/bash

neko_status=$(uci -q get neko.cfg.enabled)
neko_new_interface=$(uci -q get neko.cfg.new_interface)
neko_delay=$(uci -q get neko.cfg.delay)
neko_dir="/etc/neko"
tun_bin="$neko_dir/core/tun"
neko_pid="$neko_dir/tmp/neko_pid.txt"
log="$neko_dir/tmp/log.txt"
firewall="/etc/init.d/firewall"
neko_version=$1

# 🕓 Cooldown setting (detik)
cooldown=30
last_restart_time=0

# Pastikan direktori tmp ada
mkdir -p "$neko_dir/tmp"

restart_firewall() {
    now=$(date +%s)
    if (( now - last_restart_time > cooldown )); then
        echo "[ $(date +%T) ] Restarting firewall..." >> $log
        $firewall restart
        last_restart_time=$now
    else
        echo "[ $(date +%T) ] Firewall restart skipped (cooldown active)" >> $log
    fi
}

neko_checknewver(){
    # Fungsi dicegah menulis log versi baru
    strversion=""
    :
}

neko_reload(){
    dt=$(ubus call network.interface dump)
    len=$(echo "$dt" | jq '.interface' | jq length)

    for (( i=0; i<$len; i++ ))
    do
        tmpdt=$(echo "$dt" | jq ".interface[$i]")
        status=$(echo "$tmpdt" | jq '.up')
        iface=$(echo "$tmpdt" | jq -r '.interface')
        uptime=$(echo "$tmpdt" | jq '.uptime')

        # Lewati loopback & LAN
        if [ "$iface" == "loopback" ] || [ "$iface" == "lan" ]; then
            continue
        fi

        # Interface down → hapus tmp file
        if [ "$status" = "false" ]; then
            if [ -f "/tmp/iface/$iface" ]; then
                rm -f "/tmp/iface/$iface"
                echo "[ $(date +%T) ] Interface $iface down → cleaned tmp file" >> $log
            fi
            continue
        fi

        mkdir -p "/tmp/iface"

        if [ ! -e "/tmp/iface/$iface" ]; then
            echo "$uptime" > "/tmp/iface/$iface"
            echo "[ $(date +%T) ] Interface $iface detected → firewall reload" >> $log
            restart_firewall
            $tun_bin -ks

            uptime_now=$(cut -d. -f1 /proc/uptime)
            if [ "$uptime_now" -lt 60 ]; then
                service neko restart
            fi
        else
            last_uptime=$(cat "/tmp/iface/$iface")
            echo "$uptime" > "/tmp/iface/$iface"

            if (( uptime < last_uptime )) || [ -z "$last_uptime" ]; then
                echo "[ $(date +%T) ] Interface $iface uptime reset → firewall reload" >> $log
                restart_firewall
                sleep 1
                $tun_bin -ks
            fi
        fi
    done
}

if [ "$neko_status" == 1 ] && [ "$neko_new_interface" == 1 ]; then
    echo "[ $(date +%T) ] - Auto Restart Firewall : ON " >> $log
    cnt=0
    while true
    do
        ((cnt++))
        sleep "$neko_delay"
        neko_reload
        if [ $cnt -eq 30 ]; then
           # neko_checknewver "log"
            cnt=0
        fi
    done
else
    echo "[ $(date +%T) ] - Auto Restart Firewall : OFF " >> $log
    sleep 20
    # neko_checknewver "log"
fi
