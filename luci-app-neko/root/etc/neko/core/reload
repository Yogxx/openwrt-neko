#!/bin/sh
# ==========================
# Neko Auto Firewall Reload
# Generic multi-WAN + modem support
# Compatible with OpenWrt x86 / ARM
# ==========================

NEKO_DIR="/etc/neko"
TMP_DIR="$NEKO_DIR/tmp"
LOG="$TMP_DIR/log.txt"
COOLDOWN_FILE="$TMP_DIR/fw_last_restart"
TUN_BIN="$NEKO_DIR/core/tun"
FIREWALL="/etc/init.d/firewall"
COOLDOWN=30  # detik

mkdir -p "$TMP_DIR"

# --------------------------
# Fungsi log
# --------------------------
log_write() {
    echo "[ $(date +%T) ] $1" >> "$LOG"

    # Batasi log max 400 baris
    if [ -f "$LOG" ] && [ "$(wc -l < "$LOG")" -gt 400 ]; then
        tail -n 200 "$LOG" > "$LOG.tmp"
        mv "$LOG.tmp" "$LOG"
    fi
}

# --------------------------
# Fungsi restart firewall dengan cooldown
# --------------------------
restart_firewall() {
    now=$(date +%s)
    last=0

    [ -f "$COOLDOWN_FILE" ] && last=$(cat "$COOLDOWN_FILE")

    if [ $((now - last)) -gt $COOLDOWN ]; then
        log_write "Restart firewall"
        $FIREWALL restart
        echo "$now" > "$COOLDOWN_FILE"
    else
        log_write "Cooldown active, skip firewall restart"
    fi
}

# --------------------------
# Fungsi reload interface
# --------------------------
neko_reload() {
    json="$(ubus call network.interface dump)"

    # Ambil semua interface WAN/logical WAN atau proto modem apapun
    echo "$json" | jq -r '
        .interface[]
        | select(
            (.interface | test("wan|wwan|pppoe")) 
            or (.proto | test("dhcp|pppoe|modemmanager|mbim|xmm|wwan"))
          )
        | "\(.interface)|\(.up)|\(.uptime|floor)"
    ' | while IFS="|" read -r iface status uptime; do

        FILE="/tmp/iface_$iface"

        # Interface down → hapus tmp
        if [ "$status" = "false" ]; then
            [ -f "$FILE" ] && rm -f "$FILE"
            continue
        fi

        # Interface baru → deteksi + restart firewall
        if [ ! -f "$FILE" ]; then
            echo "$uptime" > "$FILE"
            log_write "Interface $iface detected"
            restart_firewall
            [ -x "$TUN_BIN" ] && $TUN_BIN -ks
            continue
        fi

        # Cek uptime reset → restart firewall
        last_uptime=$(cat "$FILE")
        echo "$uptime" > "$FILE"

        if [ "$uptime" -lt "$last_uptime" ]; then
            log_write "Interface $iface restarted"
            restart_firewall
            [ -x "$TUN_BIN" ] && $TUN_BIN -ks
        fi
    done
}

# --------------------------
# Main loop
# --------------------------
log_write "Auto Restart Firewall : ON"

while true; do
    sleep 5
    neko_reload
done
